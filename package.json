{
  "name": "this-is-me",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "nx": "nx",
    "content": "nx run content:generate",
    "content:production": "node scripts/build-content.ts --production",
    "content:watch": "nx run content:watch",
    "start": "nx serve this-is-me",
    "build": "nx build this-is-me",
    "watch": "nx build this-is-me --watch --configuration development",
    "test": "nx test this-is-me",
    "test:slides": "nx test slides",
    "test:content": "nx run-many -t test test-api -p content slide-creator",
    "creator": "nx serve slide-creator",
    "creator:build": "nx build slide-creator",
    "test:creator": "nx test slide-creator",
    "test:all": "nx run-many -t test test-api",
    "build:all": "nx run-many -t build",
    "graph": "nx graph"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "marked": "^18.2.1",
    "material-symbols": "^0.49.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2202.8",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@nx/angular": "^24.0.6",
    "@nx/js": "^24.0.6",
    "@nx/workspace": "^24.0.6",
    "@types/node": "^26.6.7",
    "concurrently": "^10.0.7",
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.2",
    "jsdom": "^31.0.0",
    "nx": "^24.0.6",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
