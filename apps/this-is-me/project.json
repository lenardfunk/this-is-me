{
  "name": "this-is-me",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/this-is-me/src",
  "prefix": "app",
  "tags": ["type:app"],
  "implicitDependencies": ["content"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": ["content:generate"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/this-is-me",
        "index": "apps/this-is-me/src/index.html",
        "browser": "apps/this-is-me/src/main.ts",
        "tsConfig": "apps/this-is-me/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [{ "glob": "**/*", "input": "public" }],
        "styles": [
          "@fontsource-variable/fraunces/index.css",
          "@fontsource-variable/inter/index.css",
          "material-symbols/outlined.css",
          "apps/this-is-me/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" },
            { "type": "anyComponentStyle", "maximumWarning": "8kB", "maximumError": "16kB" }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "dependsOn": ["content:watch"],
      "options": { "port": 4200 },
      "configurations": {
        "production": { "buildTarget": "this-is-me:build:production" },
        "development": { "buildTarget": "this-is-me:build:development" }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": { "tsConfig": "apps/this-is-me/tsconfig.spec.json" }
    }
  }
}
